{
	// pages 数组的第一项即为应用启动页（首页），所以首页必须放在首位
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				// 关闭原生导航栏，改用页面内自定义的固定导航栏，避免出现两条
				"navigationStyle": "custom",
				"navigationBarTitleText": "叶选商城"
			}
		},
		{
			"path": "pages/category/category",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "分类"
			}
		},
		{
			"path": "pages/address/list",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "收货地址"
			}
		},
		{
			"path": "pages/address/edit",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "编辑地址"
			}
		},
		{
			"path": "pages/product/detail",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "商品详情"
			}
		},
		{
			"path": "pages/search/search",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "搜索"
			}
		},
		{
			"path": "pages/cart/cart",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "购物车"
			}
		},
		{
			"path": "pages/coupon/list",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "优惠券"
			}
		},
		{
			"path": "pages/order/confirm",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "确认订单"
			}
		},
		{
			"path": "pages/order/list",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "我的订单"
			}
		},
		{
			"path": "pages/order/detail",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "订单详情"
			}
		},
		{
			// 登录页：不进 tabBar，也不该被未登录拦截器挡住（见 App.vue 白名单）
			"path": "pages/login/login",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/profile/profile",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "个人中心"
			}
		}
	],
	// 说明：本项目当前没有 tabBar。
	// 因此跳首页只能用 uni.reLaunch / uni.redirectTo，不能用 uni.switchTab（它只认 tabBar 页面）。
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "叶选商城",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	}
}
